# Supabase public project configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Email for the single-password Trip Hub login. Keep this server-only.
TRIP_LOGIN_EMAIL=
# Canonical app URL used for password recovery links.
NEXT_PUBLIC_SITE_URL=

# Google Maps: use separately restricted browser and server keys.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=
GOOGLE_MAPS_GEOCODING_API_KEY=
# Optional. Required for styled markers on the Ideas map view.
# Create at Cloud Console > Google Maps Platform > Map Management (vector).
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
